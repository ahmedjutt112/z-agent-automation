{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/desktop && npm install && npm run build",
  "outputDirectory": "apps/desktop/renderer/dist",
  "installCommand": "cd apps/desktop && npm install",
  "framework": "vite",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/ai/chat", "destination": "/api/ai_chat" },
    { "source": "/api/ai/models", "destination": "/api/providers" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
