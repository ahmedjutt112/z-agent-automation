# Sensitive files — never commit
.env
.env.local
.env.*.local
*.log
logs/

# Database files (local SQLite fallback when Turso unreachable)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Skills catalog (vendored)
skills/

