node_modules/
dist/
build/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Screenshots generated by automation (regenerated per run)
download/screenshots/

# Playwright browser binaries
.playwright/
