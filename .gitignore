# Sensitive files — never commit
.env
.env.local
.env.*.local
*.log
logs/

# Database files (local SQLite fallback when Turso unreachable)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Skills catalog (vendored)
skills/

# Build artifacts
node_modules/
dist/
build/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Tool results (transient — saved by tooling during sessions)
tool-results/

# Screenshots generated by automation (regenerated per run)
download/screenshots/

# Uploaded files (user-provided source material — don't commit)
upload/

# Playwright browser binaries
.playwright/

# Lock files for in-progress state
*.lock

.vercel
.env*
.vercel
.vercel/

# Mobile + build artifacts (too large for git, distributed via Releases)
apps/desktop/android/
apps/desktop/release/
apps/desktop/release-win/
apps/desktop/.vercel/
apps/desktop/capacitor.config.json
download/builds/
*.apk
*.AppImage
*.dmg
*.exe
*.msi
*.nupkg
local.properties

# JDK installs
jdk/
jdk17/
jdk21/
android-sdk/

# Capacitor + Android
apps/desktop/android/local.properties
