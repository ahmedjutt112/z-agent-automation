# ==========================================================================
# z-agent + AI PC/Laptop Automation Agent — .env.example (template)
# Copy to .env and fill in your real values. Never commit .env.
# ==========================================================================

# === Database (Turso libSQL — primary) ===
# Get a free DB at https://turso.tech
DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=eyJ...your-token-here...
# Fallback local SQLite
LOCAL_SQLITE_PATH=/home/z/my-project/db/custom.db

# === Vercel AI Gateway (https://vercel.com/docs/ai-gateway) ===
# Routes to OpenAI, Anthropic, Gemini, Mistral, DeepSeek, xAI, Cohere, Groq,
# Together, Fireworks, Cerebras, SambaNova, AI21, Perplexity, OpenRouter,
# Hugging Face, NVIDIA NIM, Cloudflare, AWS Bedrock, Azure, Replicate,
# Stability, Voyage, Jina, + many more — all via ONE API key.
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
VERCEL_AI_GATEWAY_KEY=vck_your_vercel_ai_gateway_key
VERCEL_ACCESS_TOKEN=vcp_your_vercel_access_token

# === GitHub (for repo automation, issue tracking, code search) ===
GITHUB_TOKEN=ghp_your_github_pat

# === Primary AI Providers (optional — direct API access) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
AI21_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_NIM_API_KEY=
CLOUDFLARE_AI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=us-central1
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
REPLICATE_API_KEY=
STABILITY_API_KEY=
VOYAGE_API_KEY=
JINA_API_KEY=
NOCIPIUM_API_KEY=
LEPTON_API_KEY=
FRIENDLIAI_API_KEY=
BASETEN_API_KEY=
MODAL_API_KEY=
ANYSCALE_API_KEY=
DATABRICKS_TOKEN=
AI2_API_KEY=
ALEPH_ALPHA_API_KEY=
WRITER_API_KEY=
UPSTAGE_API_KEY=
BAICHUAN_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
SILICONFLOW_API_KEY=
HYPERBOLIC_API_KEY=
NEBIUS_API_KEY=

# === Local LLMs ===
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# === OAuth Providers ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/google/callback

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/github/callback

FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/facebook/callback

# Email (SMTP for sending, IMAP for receiving)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=

# === Messaging Integrations ===
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

TELEGRAM_BOT_TOKEN=

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# === Webhooks ===
WEBHOOK_BASE_URL=http://localhost:8765

# === Automation Service ===
AUTOMATION_HOST=127.0.0.1
AUTOMATION_PORT=8765
AUTOMATION_MOCK_MODE=true
AUTOMATION_IPC_TOKEN=
LOG_LEVEL=INFO
LOG_FILE=/home/z/my-project/logs/automation-service.log

# === AI defaults ===
DEFAULT_AI_PROVIDER=vercel_gateway
DEFAULT_AI_MODEL=openai/gpt-4o-mini
USE_LOCAL_MODEL_FIRST=false
USE_VISION_ONLY_WHERED=true
MIN_VISION_CONFIDENCE=0.85

# === Browser ===
BROWSER_DEFAULT=chromium
BROWSER_HEADLESS=false
