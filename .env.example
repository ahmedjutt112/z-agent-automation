# ---------------------------------------------------------------------------
# z-agent environment variables
# Copy to .env and customize as needed.
# ---------------------------------------------------------------------------

# === Database ===
# SQLite file URL. The `file:` prefix is required by SQLAlchemy/aiosqlite.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# === Logging ===
# One of: TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Optional: write logs to a file (rotating, 10 MB / 30 days)
# LOG_FILE=/home/z/my-project/logs/z-agent.log

# === Paths (override only if you restructure) ===
# MCP_CONFIG_PATH=/home/z/my-project/.mcp.json
# SKILLS_DIR=/home/z/my-project/skills
# AGENTS_DIR=/home/z/my-project/agents
# DOWNLOAD_DIR=/home/z/my-project/download
# UPLOAD_DIR=/home/z/my-project/upload

# === Optional: API keys for tools / MCP servers ===
# ZAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# === Optional: web-search MCP ===
# ZAI_SEARCH_ENDPOINT=https://api.z.ai/api/v1/search
