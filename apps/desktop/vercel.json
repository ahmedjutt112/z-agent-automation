{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "renderer/dist",
  "installCommand": "npm install",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/health.py": {
      "runtime": "@vercel/python"
    },
    "api/ai_chat.py": {
      "runtime": "@vercel/python"
    },
    "api/providers.py": {
      "runtime": "@vercel/python"
    }
  },
  "rewrites": [
    { "source": "/api/ai/chat", "destination": "/api/ai_chat" },
    { "source": "/api/ai/models", "destination": "/api/providers" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
